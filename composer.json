{
    "name": "yiisoft/yii2-app-basic",
    "description": "Yii 2 Basic Project Template",
    "keywords": ["yii2", "framework", "basic", "project template"],
    "homepage": "http://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "http://www.yiiframework.com/forum/",
        "wiki": "http://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=5.6.0",
        "yiisoft/yii2": "~2.0.14",
        "yiisoft/yii2-bootstrap": "~2.0.0",
        "yiisoft/yii2-symfonymailer": "^3.0",
        "kartik-v/yii2-widget-select2": "dev-master",
        "kartik-v/yii2-widget-sidenav": "@dev",
        "kartik-v/yii2-grid": "dev-master",
        "kartik-v/yii2-sortable-input": "dev-master",
        "kartik-v/yii2-widget-datepicker": "@dev",
        "kartik-v/yii2-widget-datetimepicker": "@dev",
        "kriss/yii2-calendar-schedule": "^2.1",
        "kartik-v/yii2-widget-colorinput": "*",
        "onmotion/yii2-widget-apexcharts": "^1.0",
        "kartik-v/yii2-checkbox-x": "dev-master",
        "hail812/yii2-adminlte3": "~1.1",
        "kartik-v/yii2-bootstrap4-dropdown": "@dev",
        "kartik-v/yii2-date-range": "@dev",
        "thoulah/yii2-fontawesome-inline": "^1.1",
        "bower-asset/chart-js": "^3.7",
        "practically/yii2-chartjs": "^1.1",
        "koolreport/yii2": "^1.0",
        "koolreport/core": "^5.6",
        "kartik-v/yii2-mpdf": "^1.0",
        "demogorgorn/yii2-ajax-submit-button": "*",
        "2amigos/yii2-file-upload-widget": "~1.0",
        "hail812/yii2-adminlte-widgets": "~1.0",
        "yiisoft/yii2-httpclient": "^2.0",
        "kartik-v/yii2-detail-view": "dev-master",
        "kartik-v/yii2-popover-x": "dev-master",
        "kartik-v/yii2-icons": "@dev",
        "kartik-v/yii2-password": "dev-master",
        "bizley/cookiemonster": "^1.1",
        "yiimaker/yii2-social-share": "^2.3",
        "kartik-v/yii2-export": "dev-master",
        "tomlutzenberger/yii2-smartsupp-chat": "*"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.1.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "codeception/codeception": "^5.0",
        "codeception/verify": "^3.0",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-yii2": "^1.1.8",
        "codeception/module-asserts": "^3.0"
    },
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
